---
import { BASE } from "../../base";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#2b2322" />
    <title>Parousia</title>
    <meta name="description" content="Your Rich Presence, present on Discord and beyond." />
    <link rel="manifest" href={`${BASE}pwa/manifest.webmanifest`} />
    <link rel="icon" type="image/png" href={`${BASE}pwa/icons/icon-32.png`} />
    <link rel="apple-touch-icon" href={`${BASE}pwa/icons/apple-touch-icon.png`} />
    <link rel="stylesheet" href={`${BASE}pwa/pwa.css`} />
  </head>
  <body>
    <div class="page">
      <header class="header">
        <img
          class="mark"
          src={`${BASE}pwa/icons/icon-32.png`}
          width="22"
          height="22"
          alt="Parousia"
        />
        <span class="wordmark" aria-hidden="true">PAROUSIA</span>
      </header>
      <main class="content" id="content" aria-live="polite"></main>
      <footer class="footer">
        <span class="status-dot"></span>
        <span>Standalone view</span>
      </footer>
    </div>
    <script>
      import { mountPresenceView } from "../../../../packages/presence-view/mount";
      import { BASE } from "../../base";

      // No bridge to the extension yet, so this always shows "no extension".
      const content = document.getElementById("content");
      if (content) {
        mountPresenceView(content, async () => ({ available: false, activity: null }));
      }

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register(`${BASE}pwa/sw.js`);
        });
      }
    </script>
  </body>
</html>
