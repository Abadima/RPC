{
  "manifest_version": 3,
  "name": "Parousia",
  "version": "1.1.0",
  "description": "Your Rich Presence on Discord and beyond.",
  "background": {
    "service_worker": "chromium.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "storage"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["*://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:57179 ws://127.0.0.1:6969 https://api.github.com"
  },
  "externally_connectable": {
    "ids": ["agnaejlkbiiggajjmnpmeheigkflbnoo"]
  }
}
