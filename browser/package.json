{
  "name": "@abadima/rpc-browser",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --watch",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "activities:fetch": "bun run scripts/activities.ts fetch",
    "activities:check": "bun run scripts/activities.ts check",
    "firefox:setup": "playwright-core install firefox",
    "firefox:lint": "web-ext lint --source-dir=dist/firefox",
    "firefox:verify": "node scripts/verify-firefox.mjs",
    "chromium:setup": "playwright-core install chromium",
    "desktop:verify": "node scripts/verify-desktop-link.mjs",
    "real:verify": "node scripts/verify-real-browsers.mjs",
    "discord:verify": "node scripts/verify-discord.mjs",
    "activities:verify": "node scripts/verify-activities.mjs",
    "activities:firefox": "node scripts/verify-activities-firefox.mjs",
    "malsync:firefox": "node scripts/verify-malsync-firefox.mjs",
    "real-extensions:fetch": "node scripts/fetch-real-extensions.mjs",
    "malsync:real": "node scripts/verify-malsync-real.mjs",
    "youtube:verify": "node scripts/verify-youtube.mjs",
    "languages:verify": "node scripts/verify-languages.mjs",
    "languages:firefox": "node scripts/verify-languages-firefox.mjs",
    "fallback:verify": "node scripts/verify-fallback.mjs",
    "bench": "node scripts/bench.mjs",
    "contrast": "bun run scripts/contrast.ts",
    "themes:verify": "node scripts/verify-themes.mjs"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "web-ext": "^10.7.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
