# A template for `browser/.env` (git-ignored), which `bun run amo:push` reads:
# the Add-ons (AMO) key pair from https://addons.mozilla.org/en-US/developers/addon/api/key/.
AMO_JWT_ISSUER=paste-your-issuer-here
AMO_JWT_SECRET=the-secret-from-the-developer-hub

# The add-on slug and API root, which the defaults already fit.
#AMO_ADDON_SLUG=parousia
#AMO_API_BASE=https://addons.mozilla.org/api/v5
